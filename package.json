{
  "name": "omp-extensions",
  "private": true,
  "type": "module",
  "description": "CNife 的 OMP agent 插件 marketplace",
  "license": "MIT",
  "scripts": {
    "check": "bun test && tsc --noEmit && bun scripts/check.ts",
    "check:staged": "bun test && tsc --noEmit && bun scripts/check.ts --staged",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "manifests": "bun scripts/check.ts",
    "smoke": "bun scripts/smoke.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.11.3",
    "@oh-my-pi/pi-tui": "18.11.3",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
