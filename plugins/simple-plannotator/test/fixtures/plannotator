#!/usr/bin/env bash
set -u
if [ -n "${PLANNO_STUB_LOG:-}" ]; then
  { printf 'cwd=%s\n' "$PWD"; for a in "$@"; do printf 'arg=%s\n' "$a"; done; } >> "$PLANNO_STUB_LOG"
fi
if [ -n "${PLANNO_STUB_HANG:-}" ]; then
  # exec 让 bash 替换为 sleep：SIGKILL 直接命中同一 PID，避免遗留孤儿 sleep 孙进程。
  exec sleep 3600
fi
sleep "${PLANNO_STUB_SLEEP:-0.1}"
[ -n "${PLANNO_STUB_STDOUT:-}" ] && printf '%s\n' "$PLANNO_STUB_STDOUT"
[ -n "${PLANNO_STUB_STDERR:-}" ] && printf '%s\n' "$PLANNO_STUB_STDERR" >&2
exit "${PLANNO_STUB_EXIT:-0}"
